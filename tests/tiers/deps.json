{
  "t2-phases": {
    "genesis": {
      "prerequisites": [
        "shenbi-worldbuilding",
        "shenbi-power-system",
        "shenbi-faction-builder",
        "shenbi-location-builder",
        "shenbi-character-design",
        "shenbi-relationship-map",
        "shenbi-story-architecture",
        "shenbi-volume-outlining",
        "shenbi-genre-config",
        "shenbi-pacing-design",
        "shenbi-book-spine-init"
      ],
      "expected_outputs": [
        "characters/*.md",
        "characters/major/*.md",
        "characters/minor/*.md",
        "genre-config-decisions.json",
        "genre-config.json",
        "novel.json",
        "outline/*.md",
        "truth/*.md",
        "world/*.md"
      ],
      "g4_checker": "shenbi-worldbuilding"
    },
    "architecture": {
      "prerequisites": [
        "shenbi-story-architecture",
        "shenbi-volume-outlining",
        "shenbi-pacing-design",
        "shenbi-plot-thread-weaver",
        "shenbi-genre-config"
      ],
      "expected_outputs": [
        "genre-config-decisions.json",
        "genre-config.json",
        "outline/*.md"
      ],
      "g4_checker": "shenbi-story-architecture"
    },
    "planning": {
      "prerequisites": [
        "shenbi-chapter-planning",
        "shenbi-context-composing",
        "shenbi-foreshadowing-lifecycle"
      ],
      "expected_outputs": [
        "audits/chapter-*.md",
        "context/chapter-*-context-decisions.json",
        "context/chapter-*-context.md",
        "plans/chapter-*-plan-decisions.json",
        "plans/chapter-*-plan.md",
        "truth/*.md"
      ],
      "g4_checker": "shenbi-chapter-planning"
    },
    "drafting": {
      "prerequisites": [
        "shenbi-anti-detect",
        "shenbi-chapter-drafting",
        "shenbi-foreshadowing-lifecycle",
        "shenbi-length-normalizing",
        "shenbi-review-resonance",
        "shenbi-score-arc",
        "shenbi-state-settling",
        "shenbi-style-polishing"
      ],
      "expected_outputs": [
        "audits/arc-*-score.md",
        "audits/chapter-*.md",
        "chapters/chapter-*-decisions.json",
        "chapters/chapter-*.md",
        "truth/*.md",
        "truth/state-settling-decisions.json"
      ],
      "g4_checker": "shenbi-chapter-drafting"
    },
    "audit": {
      "prerequisites": [
        "shenbi-review-era",
        "shenbi-review-fanfic",
        "shenbi-review-group-character",
        "shenbi-review-group-craft",
        "shenbi-review-group-factual",
        "shenbi-review-group-plan",
        "shenbi-review-highpoint",
        "shenbi-review-long-span",
        "shenbi-review-sensitivity",
        "shenbi-review-spinoff"
      ],
      "expected_outputs": [
        "audits/chapter-*.md"
      ],
      "g4_checker": null,
      "_g4_note": "all audit-tier skills (grouped group-* waves + conditional singles) fall to the generic G4 checker"
    },
    "management": {
      "prerequisites": [
        "shenbi-snapshot-manage",
        "shenbi-drift-guidance",
        "shenbi-intent-management",
        "shenbi-chapter-pattern",
        "shenbi-volume-consolidation",
        "shenbi-review-arc-payoff",
        "shenbi-memory-distill",
        "shenbi-score-volume",
        "shenbi-score-stratum"
      ],
      "expected_outputs": [
        "audits/stratum-*-score.md",
        "audits/volume-*-score.md",
        "audits/volume-*.md",
        "context/chapter-pattern-input-*.json",
        "outline/*.md",
        "snapshots/chapter-NNN/*",
        "truth/*.md",
        "truth/arcs/arc-*.md"
      ],
      "g4_checker": null,
      "_g4_note": "G4 checker for snapshot-manage not yet implemented in validate-gate.py"
    },
    "import": {
      "prerequisites": [
        "shenbi-import-analysis",
        "shenbi-character-extraction",
        "shenbi-world-extraction",
        "shenbi-canon-import"
      ],
      "expected_outputs": [
        "characters/*.md",
        "characters/major/*.md",
        "characters/minor/*.md",
        "import/analysis/*.md",
        "import/canon/*.md",
        "world/*.md"
      ],
      "g4_checker": null,
      "_g4_note": "G4 checker for import-analysis not yet implemented in validate-gate.py"
    },
    "foundation": {
      "prerequisites": [
        "shenbi-foundation-review",
        "shenbi-chapter-revision",
        "shenbi-truth-sync",
        "shenbi-style-learning"
      ],
      "expected_outputs": [
        "chapters/chapter-*-revision-decisions.json",
        "chapters/chapter-*.md",
        "foundation/review_report.md",
        "style/style_profile.md",
        "truth/*.md"
      ],
      "g4_checker": null,
      "_g4_note": "G4 checker for foundation-review not yet implemented in validate-gate.py"
    },
    "short-story": {
      "prerequisites": [
        "shenbi-short-outline",
        "shenbi-short-drafting",
        "shenbi-short-packaging"
      ],
      "expected_outputs": [
        "chapters/chapter-*.md",
        "import/packaging/*",
        "outline/*.md",
        "short/short-*-decisions.json"
      ],
      "g4_checker": null,
      "_g4_note": "G4 checker for short-outline not yet implemented in validate-gate.py"
    }
  },
  "t3-pipelines": {
    "long-form": {
      "prerequisites": [
        "genesis",
        "architecture",
        "planning",
        "drafting",
        "audit",
        "foundation",
        "management"
      ],
      "min_chapter_ratio": 0.5
    },
    "short-form": {
      "prerequisites": [
